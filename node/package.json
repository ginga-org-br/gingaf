{
  "name": "ginga-node",
  "version": "0.4.0",
  "description": "Node.js distribution and Express middleware for the GingaF web player and playground",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ginga",
    "gingaf",
    "ncl",
    "ncl4",
    "ncl360",
    "dtv",
    "sbtvd",
    "express",
    "middleware"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ginga-org-br/gingaf.git",
    "directory": "node"
  },
  "homepage": "https://github.com/ginga-org-br/gingaf#readme",
  "bugs": {
    "url": "https://github.com/ginga-org-br/gingaf/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "node --test test/ginga-node.test.js",
    "test:package": "node --test test/ginga-node.test.js test/bundle.test.js",
    "clean": "rm -rf dist *.tgz",
    "pack:check": "npm pack --dry-run",
    "start-express": "npm --prefix example-node-express start"
  },
  "peerDependencies": {
    "express": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "esbuild": "^0.28.2",
    "express": "^4.19.2",
    "typescript": "^5.4.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
