{
  "name": "playground",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); ['dist', 'public/gingaf-web'].forEach(d => fs.existsSync(d) && fs.rmSync(d, { recursive: true, force: true }));\"",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "npx concurrently \"npm run dev\" \"npx serve -p 8080 ../ginga/build/web --cors\""
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "8.2.1"
  },
  "dependencies": {
    "gingaf-node": "file:../ginga-node",
    "monaco-editor": "^0.53.0"
  }
}
