FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    clang \
    cmake \
    ninja-build \
    pkg-config \
    libgtk-3-dev \
    liblzma-dev \
    libwebkit2gtk-4.1-dev \
    libmpv-dev \
    mpv \
    curl \
    git \
    unzip \
    && rm -rf /var/lib/apt/lists/*

RUN git config --system --add safe.directory '*'

ENV PATH="/opt/flutter/bin:${PATH}"
