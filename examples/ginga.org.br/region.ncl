<ncl>
  <head>
    <regionBase>
      <region id="rgOuter" left="10%" top="10%" width="80%" height="80%">
        <region id="rgInner" left="15%" top="15%" width="70%" height="70%"/>
      </region>
    </regionBase>
    <descriptorBase>
      <descriptor id="dInner" region="rgInner"/>
    </descriptorBase>
  </head>
  <body>
    <port id="p0" component="logo"/>
    <media id="logo" src="https://upload.wikimedia.org/wikipedia/commons/c/ce/Ginga_Middleware_Logo.png" descriptor="dInner"/>
  </body>
</ncl>
