<ncl>
  <body>
    <metadata>
      <rdf:RDF
        xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
        xmlns:dc="http://purl.org/dc/elements/1.1/">
        <rdf:Description rdf:about="">
          <dc:title>Ginga Interactive Program</dc:title>
          <dc:creator>Ginga.org.br</dc:creator>
          <dc:description>RDF Dublin Core metadata attached to the NCL body</dc:description>
          <dc:language>en</dc:language>
          <dc:date>2026-11-27</dc:date>
          <dc:rights>CC BY 4.0</dc:rights>
        </rdf:Description>
      </rdf:RDF>
    </metadata>
    <port id="p0" component="scene"/>
    <context id="scene">
      <metadata>
        <rdf:RDF
          xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
          xmlns:dc="http://purl.org/dc/elements/1.1/">
