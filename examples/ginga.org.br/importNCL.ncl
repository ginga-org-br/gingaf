<ncl>
  <head>
    <importedDocumentBase>
      <importNCL alias="doc" documentURI="media_image.ncl"/>
    </importedDocumentBase>
  </head>
  <body>
    <port id="p0" component="mainLogo"/>
    <media id="mainLogo" src="https://upload.wikimedia.org/wikipedia/commons/c/ce/Ginga_Middleware_Logo.png"/>
    <media id="importedLogo" refer="doc#img" instance="new"/>
  </body>
</ncl>
