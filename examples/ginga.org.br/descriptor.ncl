<ncl>
  <head>
    <regionBase>
      <region id="rgMain" left="25%" top="25%" width="50%" height="50%"/>
    </regionBase>
    <descriptorBase>
      <descriptor id="dLogo" region="rgMain" explicitDur="5s"/>
    </descriptorBase>
  </head>
  <body>
    <port id="p0" component="logo"/>
    <media id="logo" src="https://upload.wikimedia.org/wikipedia/commons/c/ce/Ginga_Middleware_Logo.png" descriptor="dLogo"/>
  </body>
</ncl>
